# 环境变量配置
# 复制此文件为 .env 并填入你的 key

# LLM 配置：一个 provider + 一个 model 即可切换厂商
ATA_LLM_PROVIDER=qwen
ATA_LLM_MODEL=qwen3.6-flash

# Qwen / DashScope（默认）
DASHSCOPE_API_KEY=your_dashscope_api_key_here
# QWEN_API_KEY=your_qwen_api_key_here

# 可选厂商：按需填 key，不用的保持注释即可
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
# OPENAI_API_KEY=your_openai_key_here
# KIMI_API_KEY=your_kimi_key_here
# GLM_API_KEY=your_glm_key_here
# ANTHROPIC_API_KEY=your_anthropic_key_here

# 兼容旧字段：如未设置 ATA_LLM_MODEL，可继续使用下列两个字段
# ATA_DEEP_THINK_LLM=qwen3.6-flash
# ATA_QUICK_THINK_LLM=qwen3.6-flash

# 数据源配置
# 默认免费优先: akshare 无需 token，但有频率限制
AKSHARE_ENABLED=true
# 免费兜底: baostock/sina/eastmoney 均无需 token
BAOSTOCK_ENABLED=true
SINA_ENABLED=true
EASTMONEY_ENABLED=true

# 数据缓存
ATA_DATA_CACHE_DIR=./data/cache
ATA_RESULTS_DIR=./data/results
ATA_MEMORY_LOG_PATH=./data/memory/trading_memory.md

# 运行配置
ATA_MAX_DEBATE_ROUNDS=2
MAX_RISK_ROUNDS=2
ATA_OUTPUT_LANGUAGE=Chinese
ATA_TEMPERATURE=0.1
